---
import type { Dict } from '../i18n/en';

interface Props {
  t: Dict;
  releasesHref: string;
  repo: string;
}

const { t, releasesHref, repo } = Astro.props;
---

<section class="hero">
  <div class="hero-copy">
    <span class="badge">{t.hero.badge}</span>
    <h1>{t.hero.titleA}<br />{t.hero.titleB}</h1>
    <p class="lede">{t.hero.subtitle}</p>
    <div class="cta">
      <a class="btn primary" href={releasesHref}>{t.hero.download}</a>
      <a class="btn ghost" href={repo}>{t.hero.viewSource}</a>
    </div>
  </div>
  <div class="hero-mock" role="img" aria-label={t.hero.pillAria}>
    <div class="menubar">
      <span class="pill"><span class="spark">✦</span> 42%</span>
    </div>
    <div class="popcard">
      <div class="pop-head">
        <span class="tile">>_</span>
        <span class="pop-title">{t.hero.cardTitle}<small>{t.hero.cardAccount}</small></span>
        <span class="status"><i></i>{t.hero.cardStatus}</span>
      </div>
      <div class="row"><span>5-hour limit</span><b>42%</b></div>
      <div class="bar"><i style="width:42%"></i></div>
      <div class="row"><span>Weekly limit</span><b>18%</b></div>
      <div class="bar"><i style="width:18%"></i></div>
    </div>
    <p class="mock-note">{t.hero.mockNote}</p>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2.5rem;
    align-items: center;
    padding-top: 3.5rem;
  }
  .badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--secondary);
    border: 1px solid var(--separator);
    background: var(--card);
    border-radius: 999px;
    padding: 0.25rem 0.8rem;
    margin-bottom: 1rem;
  }
  h1 { font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.12; letter-spacing: -0.02em; margin: 0 0 1rem; }
  .lede { color: var(--secondary); font-size: 1.05rem; max-width: 34rem; margin: 0 0 1.6rem; }
  .cta { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  .hero-mock { display: flex; flex-direction: column; align-items: center; gap: 0.9rem; }
  .menubar {
    background: var(--elevated);
    border: 1px solid var(--separator);
    border-radius: 10px;
    padding: 0.45rem 3rem;
  }
  .pill {
    background: var(--codex);
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    border-radius: 999px;
    padding: 0.25rem 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .spark { font-size: 0.75rem; margin-right: 0.15rem; }
  .popcard {
    width: 100%;
    max-width: 340px;
    background: var(--card);
    border: 1px solid var(--separator);
    border-radius: var(--radius);
    padding: 1rem 1.1rem;
  }
  .pop-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.9rem; }
  .tile {
    width: 28px; height: 28px;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 0.7rem; font-weight: 700;
    color: var(--codex);
    background: color-mix(in srgb, var(--codex) 12%, transparent);
    border-radius: 8px;
    font-family: ui-monospace, monospace;
  }
  .pop-title { font-weight: 700; font-size: 0.92rem; line-height: 1.25; }
  .pop-title small { display: block; font-weight: 400; color: var(--secondary); font-size: 0.72rem; }
  .status { margin-left: auto; display: flex; align-items: center; gap: 0.3rem; font-size: 0.72rem; color: var(--secondary); }
  .status i { width: 7px; height: 7px; border-radius: 50%; background: var(--codex); }
  .row { display: flex; justify-content: space-between; font-size: 0.85rem; margin-top: 0.55rem; }
  .row b { color: var(--codex); font-variant-numeric: tabular-nums; }
  .bar { height: 6px; border-radius: 999px; background: var(--track); margin-top: 0.3rem; }
  .bar i { display: block; height: 100%; border-radius: 999px; background: var(--codex); }
  .mock-note { color: var(--muted); font-size: 0.75rem; margin: 0; }
  @media (max-width: 820px) { .hero { grid-template-columns: 1fr; } }
</style>
