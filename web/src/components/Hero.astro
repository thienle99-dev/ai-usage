---
import type { Messages } from '../lib/i18n';
import { withVersion } from '../lib/i18n';
import { assetUrl } from '../lib/downloads';
import { withBase } from '../lib/paths';

interface Props {
  t: Messages;
  releasesHref: string;
  repo: string;
}

const { t, releasesHref, repo } = Astro.props;
---

<section class="relative overflow-hidden">
  <div class="bg-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 pb-16 pt-14 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:pt-20">
    <div class="animate-rise">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-semibold text-mist"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-teal"></span>
        {t.hero.badge}
      </p>
      <h1 class="font-display mt-5 text-balance text-4xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-5xl">
        {t.hero.titleA}
        <br />
        <span class="text-teal-bright">{t.hero.titleB}</span>
      </h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-mist sm:text-lg">{t.hero.subtitle}</p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a
          href={assetUrl()}
          class="interactive-lift rounded-full bg-teal px-5 py-2.5 text-sm font-semibold text-on-accent shadow-[0_10px_30px_rgba(42,168,146,0.35)] hover:bg-teal-bright"
        >
          {t.hero.download}
        </a>
        <a
          href={withBase(releasesHref.replace(/^\//, ''))}
          class="interactive-lift rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/10"
        >
          {t.hero.viewReleases}
        </a>
        <a href={repo} class="px-2 py-2 text-sm font-medium text-mist transition-colors hover:text-white">
          {t.hero.viewSource} →
        </a>
      </div>
      <p class="font-mono mt-4 text-xs text-mist/70">{withVersion(t.hero.versionNote)}</p>
    </div>
    <div class="animate-rise animate-rise-delay-1" role="img" aria-label={t.hero.pillAria}>
      <div class="mx-auto w-fit rounded-2xl border border-white/10 bg-white/5 px-10 py-2.5 backdrop-blur">
        <span class="rounded-full bg-teal px-3 py-1 text-sm font-bold text-on-accent [font-variant-numeric:tabular-nums]">
          <span class="mr-1 text-xs">✦</span>42%
        </span>
      </div>
      <div class="mx-auto mt-4 w-full max-w-sm rounded-2xl border border-white/10 bg-panel/80 p-5 shadow-[0_24px_60px_rgba(0,0,0,0.45)] backdrop-blur">
        <div class="mb-4 flex items-center gap-2.5">
          <span
            class="font-mono inline-flex h-7 w-7 items-center justify-center rounded-lg bg-teal/15 text-[0.65rem] font-bold text-teal-bright"
          >
            &gt;_
          </span>
          <span class="text-sm font-bold text-white">
            {t.hero.cardTitle}
            <small class="block text-xs font-normal text-mist">{t.hero.cardAccount}</small>
          </span>
          <span class="ml-auto flex items-center gap-1.5 text-xs text-mist">
            <i class="h-1.5 w-1.5 rounded-full bg-teal"></i>{t.hero.cardStatus}
          </span>
        </div>
        <div class="mt-2.5 flex justify-between text-[0.83rem]">
          <span class="text-fog">5-hour limit</span><b class="text-teal-bright [font-variant-numeric:tabular-nums]">42%</b>
        </div>
        <div class="mt-1.5 h-1.5 rounded-full bg-white/10"><i class="block h-full w-[42%] rounded-full bg-teal"></i></div>
        <div class="mt-2.5 flex justify-between text-[0.83rem]">
          <span class="text-fog">Weekly limit</span><b class="text-teal-bright [font-variant-numeric:tabular-nums]">18%</b>
        </div>
        <div class="mt-1.5 h-1.5 rounded-full bg-white/10"><i class="block h-full w-[18%] rounded-full bg-teal"></i></div>
      </div>
      <p class="mt-3 text-center text-xs text-mist/60">{t.hero.mockNote}</p>
    </div>
  </div>
</section>
