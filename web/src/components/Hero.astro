---
import type { Messages } from '../lib/i18n';
import { withVersion } from '../lib/i18n';
import { dmgAssetUrl } from '../lib/downloads';
import { withBase } from '../lib/paths';
import ThemedShot from './ThemedShot.astro';

interface Props {
  t: Messages;
  releasesHref: string;
  repo: string;
}

const { t, releasesHref, repo } = Astro.props;
---

<section class="relative overflow-hidden">
  <div class="bg-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 pb-16 pt-14 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:pt-20">
    <div class="animate-rise">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-semibold text-mist"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-teal"></span>
        {t.hero.badge}
      </p>
      <h1 class="font-display mt-5 text-balance text-4xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-5xl">
        {t.hero.titleA}
        <br />
        <span class="text-teal-bright">{t.hero.titleB}</span>
      </h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-mist sm:text-lg">{t.hero.subtitle}</p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a
          href={dmgAssetUrl()}
          class="interactive-lift rounded-full bg-teal px-5 py-2.5 text-sm font-semibold text-on-accent shadow-[0_10px_30px_rgba(42,168,146,0.35)] hover:bg-teal-bright"
        >
          {t.hero.download}
        </a>
        <a
          href={withBase(releasesHref.replace(/^\//, ''))}
          class="interactive-lift rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/10"
        >
          {t.hero.viewReleases}
        </a>
        <a href={repo} class="px-2 py-2 text-sm font-medium text-mist transition-colors hover:text-white">
          {t.hero.viewSource} →
        </a>
      </div>
      <p class="font-mono mt-4 text-xs text-mist/70">{withVersion(t.hero.versionNote)}</p>
    </div>
    <div class="animate-rise animate-rise-delay-1 mx-auto w-full max-w-[19rem]">
      <ThemedShot name="popover" alt={t.showcase.popoverAlt} width={610} height={1000} />
      <p class="mt-3 text-center text-xs text-mist/60">{t.showcase.sampleNote}</p>
    </div>
  </div>
</section>
