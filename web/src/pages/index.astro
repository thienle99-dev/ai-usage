---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Sections from '../components/Sections.astro';
import { en } from '../i18n/en';

const repo = 'https://github.com/thienle99-dev/ai-usage';
---

<Base lang="en" title={en.meta.tagline} description={en.meta.description} path="/">
  <Hero t={en} releasesHref="/releases" repo={repo} />
  <Sections t={en} />
</Base>
