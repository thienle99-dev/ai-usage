---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/Hero.astro';
import Sections from '../components/Sections.astro';
import { messages } from '../lib/i18n';

const repo = 'https://github.com/thienle99-dev/ai-usage';
const t = messages.en;
---

<Base lang="en" title={t.meta.tagline} description={t.meta.description} path="/">
  <SiteHeader lang="en" t={t} />
  <main id="main">
    <Hero t={t} releasesHref="/releases" repo={repo} />
    <Sections t={t} />
  </main>
  <SiteFooter lang="en" t={t} />
</Base>
