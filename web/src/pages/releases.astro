---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { messages } from '../lib/i18n';
import { assetUrl, releaseRepo } from '../lib/downloads';

const t = messages.en;
const releases = (await getCollection('releases')).sort((a, b) =>
  b.data.version.localeCompare(a.data.version, undefined, { numeric: true }),
);
---

<Base lang="en" title={t.releasesPage.title} description={t.releasesPage.subtitle} path="/releases">
  <SiteHeader lang="en" t={t} />
  <main id="main" class="mx-auto max-w-6xl px-4 pb-20 pt-10 sm:px-8">
    <div data-reveal>
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-teal-bright">{t.releasesPage.eyebrow}</p>
      <h1 class="font-display mt-2 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{t.releasesPage.title}</h1>
      <p class="mt-2 max-w-2xl text-mist">{t.releasesPage.subtitle}</p>
    </div>
    {
      releases.length === 0 ? (
        <div data-reveal class="mt-7 rounded-2xl border border-white/10 bg-panel/70 p-5">
          <p class="text-mist">{t.releasesPage.empty}</p>
        </div>
      ) : (
        <div class="mt-7 grid gap-4">
          {releases.map((r, i) => (
            <article
              data-reveal
              class="interactive-lift rounded-2xl border border-white/10 bg-panel/70 p-5 hover:border-teal/40 sm:p-6"
            >
              <div class="flex flex-wrap items-center gap-2.5">
                <h2 class="font-display text-xl font-bold text-white">v{r.data.version}</h2>
                {i === 0 && (
                  <span class="rounded-full bg-teal/15 px-2.5 py-0.5 text-xs font-semibold text-teal-bright">
                    {t.releasesPage.latest}
                  </span>
                )}
                <span class="ml-auto text-sm text-mist/70">{r.data.date}</span>
              </div>
              <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-mist">
                {r.data.highlights.map((h) => <li>{h}</li>)}
              </ul>
              <div class="mt-4 flex flex-wrap gap-2.5">
                <a
                  href={assetUrl(r.data.version)}
                  class="rounded-full bg-teal px-4 py-2 text-sm font-semibold text-white shadow-[0_10px_30px_rgba(42,168,146,0.35)] transition hover:bg-teal-bright active:scale-[0.98]"
                >
                  {t.releasesPage.downloadAsset}
                </a>
                <a
                  href={`${releaseRepo}/releases/tag/v${r.data.version}`}
                  class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10"
                >
                  {t.releasesPage.downloadTag}
                </a>
              </div>
            </article>
          ))}
        </div>
      )
    }
    <div data-reveal class="mt-4 rounded-2xl border border-white/10 bg-panel/70 p-5">
      <p class="text-sm text-mist">{t.releasesPage.buildFromSource}</p>
      <pre class="font-mono mt-2 overflow-x-auto rounded-xl border border-white/10 bg-ink-soft p-3 text-[0.83rem] text-fog"><code>{t.releasesPage.buildCommand}</code></pre>
    </div>
  </main>
  <SiteFooter lang="en" t={t} />
</Base>
